# development | production  (tests use their own config)
APP_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# Neon Postgres. Use the pooled ("-pooler") connection string for the app.
# Run migrations against the direct (non-pooled) string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/utibu?sslmode=require&channel_binding=require

# Comma-separated list of allowed browser origins (Expo web). Native apps aren't affected by CORS.
CORS_ORIGINS=http://localhost:8081

HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO
DELIVERY_FEE=250

# Rate limiting. Use a shared store (e.g. redis://...) when running more than one instance.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_AUTH=10 per minute

# Safaricom Daraja (M-Pesa Express)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-api.example.com/api/v1/payments/mpesa/callback
MPESA_CALLBACK_TOKEN=
